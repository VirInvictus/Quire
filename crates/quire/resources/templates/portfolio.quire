# Portfolio

// prices are hand-typed snapshots - update them and everything follows

## Positions
aapl = 10 * 190 @ 2026-10-06 @stocks
msft = 4 * 410 @ 2026-10-06 @stocks
bonds = 5000 @bonds

whole = total
total @stocks
total @bonds

## Allocation
// Alt+Up/Down on a line cycles its format - try it on the pcts
pct(x) = x / whole * 100
stocks_pct = pct(aapl + msft)
bonds_pct = pct(bonds)
