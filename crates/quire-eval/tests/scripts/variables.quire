// Variables flow downward only; reassignment wins below. A bare
// identifier line references the variable when it is bound above.
milk = 3.50
milk //= 3.5
milk * 2 //= 7
bread = 2.25
(milk) + bread //= 5.75
x = 2
x * 10 //= 20
x = 3
x * 10 //= 30
(answer) //= 30
(answer)
# expect: 30
_identifier9 = 1
